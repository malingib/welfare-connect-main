# SPA fallback: serve index.html for client-side routes (/dashboard, etc.)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Last-resort fallback if mod_rewrite is disabled
ErrorDocument 404 /index.html

# The HTML entrypoint contains Vite's current hashed asset names and must be
# revalidated after each deployment. Hashed assets can remain cached safely.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:js|css|png|jpg|jpeg|gif|svg|webp|woff2?)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
